rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == 'nguyenxuantuyensadu@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /users/{userId} {
      // Authenticated users can read and manage user profiles
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /menu/{itemId} {
      // Menu items can be read by anyone (or staff), modified by authenticated users
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /orders/{orderId} {
      // Any authenticated user can create, read, and update order status (kitchen and staff)
      allow read, create, update: if isAuthenticated();
      // Only authenticated users can delete/archive orders
      allow delete: if isAuthenticated();
    }

    match /settings/{settingId} {
      // Settings like QR payment & options can be read freely and updated by authenticated users
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
